def cmd_get(args: argparse.Namespace) -> int:
    state = load_state()
    mig_id = resolve_id(args.id, state)
    mig = state["migrations"].get(mig_id)
    if not mig:
        err(f"migration {mig_id} not found")
        return 2

    # Simulate progress since last view.
    progress = advance_migration(mig)
    state["migrations"][mig_id] = mig
    save_state(state)

    log("INFO", "tcld/migration",
        f"fetching migration {mig_id}")
    sleep(180, 320)
    log("INFO", "tcld/migration",
        "migration record retrieved",
        version=mig["version"],
        last_modified_at=mig["last_modified_at"])
    sleep(60, 120)

    # Print live replication lag / shard progress for a richer view.
    log("INFO", "tcld/replication",
        "querying replication stream metrics",
        cell=mig["cell_id"])
    sleep(220, 360)

    caught_up_shards = progress["caught_up_shards"]
    total_shards = mig["shard_count"]
    replication_lag_ms = progress["replication_lag_ms"]
    backfill_pct = progress["backfill_pct"]

    log("INFO", "tcld/replication",
        "replication stream healthy",
        shards_in_sync=f"{caught_up_shards}/{total_shards}",
        p50_lag_ms=replication_lag_ms,
        p99_lag_ms=int(replication_lag_ms * 3.2),
        bytes_per_sec=f"{random.randint(18, 74)}MiB/s")
    sleep(90, 170)

    log("INFO", "tcld/replication",
        "force-replication backfill progress",
        workflow_id=mig["force_replication_workflow_id"],
        complete_pct=f"{backfill_pct}%",
        tasks_ack=random.randint(1_200_000, 3_900_000),
        tasks_pending=random.randint(0, 400_000))
    sleep(80, 140)

    print()
    print_migration(mig)
    print()

    # Render the JSON as if returned from the API for verisimilitude.
    print(c(DIM, "---- CustomerDrivenMigration (raw) ----"))
    print(json.dumps(mig, indent=2))
    return 0


def advance_migration(mig: dict) -> dict:
    """Deterministically advance the migration each time get is called.

    First call: ~2/3 replicated, still MIGRATION_STARTED (not ready for handover).
    Second call onward: 100% replicated, HANDOVER_PENDING (ready for handover).
    """
    call = mig.get("_get_count", 0) + 1
    mig["_get_count"] = call

    if call == 1:
        pct = 67
    else:
        pct = 100
        if mig["status_code"] == 1:
            mig["status"] = "STATE_MIGRATION_HANDOVER_PENDING"
            mig["status_code"] = 3
            for r in mig["replicas"]:
                if r["status"] == "PassiveOutOfSync":
                    r["status"] = "PassiveInSync"
            mig["last_modified_at"] = now_iso()
            mig["version"] += 1

    mig["_backfill_pct"] = pct
    caught_up = int(mig["shard_count"] * (pct / 100.0))
    lag_ms = random.randint(40, 180) if pct < 85 else random.randint(8, 35)
    return {
        "caught_up_shards": caught_up,
        "replication_lag_ms": lag_ms,
        "backfill_pct": pct,
    }


