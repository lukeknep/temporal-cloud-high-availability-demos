def cmd_start(args: argparse.Namespace) -> int:
    # Each 'start' wipes any prior local state so the demo runs fresh.
    state = {"migrations": {}, "last_id": None}

    mig_id = f"cdm-{ulid()}"
    account_id = f"acct-{short_hex(8)}"
    cell_id = random.choice([
        "cell-us-east-1-a",
        "cell-us-west-2-c",
        "cell-eu-central-1-b",
        "cell-ap-southeast-2-a",
    ])
    region = cell_id.split("cell-")[1].rsplit("-", 1)[0]
    source_ns_id = ns_uuid()
    target_ns_id = ns_uuid()
    fv_onprem = random.choice([100, 200, 300])
    fv_cloud = fv_onprem + 100
    shard_count = random.choice([256, 512, 1024])

    direction = args.direction or "s2c"
    if direction == "s2c":
        direction_str = "SelfHostedToCloud"
        source_active = "on-prem"
        passive = "cloud"
    else:
        direction_str = "CloudToSelfHosted"
        source_active = "cloud"
        passive = "on-prem"

    log("INFO", "tcld/migration",
        f"resolving migration endpoint {args.endpoint_id}...")
    sleep(180, 280)
    log("INFO", "tcld/migration",
        "migration endpoint resolved",
        cell=cell_id, region=region, status="HEALTHY",
        ingress="tls://migration.temporal.cloud:7233")
    sleep(60, 140)

    log("INFO", "tcld/migration",
        f"validating source namespace {c(BOLD, args.source_namespace)} via S2S Proxy localhost:8233")
    sleep(240, 380)
    log("INFO", "tcld/s2sproxy",
        "handshake complete",
        cipher="TLS_AES_256_GCM_SHA384",
        peer_cn="onprem.migration.client",
        alpn="h2")
    sleep(80, 160)
    log("INFO", "tcld/migration",
        "source namespace validated",
        namespace_id=source_ns_id,
        history_shards=shard_count,
        active_cluster="onprem-dc1",
        clusters="[onprem-dc1]")
    sleep(120, 200)

    log("INFO", "tcld/migration",
        "verifying mTLS trust chain on cloud ingress")
    sleep(140, 260)
    log("INFO", "tcld/migration",
        "mTLS chain verified",
        subject_cn=f"{account_id}.client",
        issuer="Temporal Cloud Root CA",
        expires="2027-03-01T00:00:00Z",
        spiffe_id=f"spiffe://temporal.cloud/{account_id}")
    sleep(80, 140)

    log("INFO", "tcld/migration",
        "inspecting namespace metrics for capacity planning")
    sleep(220, 360)
    log("INFO", "tcld/migration",
        "capacity ok",
        open_workflows=random.randint(18_000, 92_000),
        closed_workflows=random.randint(1_500_000, 4_200_000),
        p95_actions_per_second=random.randint(340, 890),
        retention_days=30)
    sleep(90, 180)

    log("INFO", "tcld/migration",
        f"creating cloud namespace {c(BOLD, args.target_namespace)} as PASSIVE replica")
    sleep(340, 520)
    log("INFO", "tcld/frontend",
        "RegisterNamespace accepted",
        namespace_id=target_ns_id,
        retention_days=30,
        archival="disabled",
        is_global_namespace="true",
        replication_config=f"active={source_active}, clusters=[on-prem, cloud]")
    sleep(110, 180)

    log("INFO", "tcld/migration",
        "provisioning failover versions",
        onprem=fv_onprem, cloud=fv_cloud)
    sleep(80, 160)
    log("INFO", "tcld/history",
        "shard failover version tables updated",
        shards_updated=shard_count, duration_ms=random.randint(210, 540))
    sleep(120, 200)

    log("INFO", "tcld/migration",
        "enabling cross-cluster replication (GlobalNamespace=true)")
    sleep(220, 340)
    log("INFO", "tcld/replication",
        "replication stream established",
        source_cluster="onprem-dc1",
        target_cluster=f"cloud-{cell_id}",
        direction="onprem-dc1 -> cloud",
        task_queue="temporal-sys-replication-tq")
    sleep(160, 260)

    log("INFO", "tcld/migration",
