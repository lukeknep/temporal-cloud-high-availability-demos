#!/usr/bin/env python3
"""
tcld — mock Temporal Cloud CLI (migration subcommands only).

Intended for vision demos. Output is simulated; state is persisted in
/tmp/tcld-migration-state.json so follow-up commands chain naturally.

Supported commands:
  tcld migration start --endpoint-id ID --source-namespace NS --target-namespace NS [--direction s2c|c2s]
  tcld migration get [--id ID]
  tcld migration handover [--id ID] --to-replica-id {cloud|on-prem}
  tcld migration confirm [--id ID]

Flag aliases match the real CLI: -id, -rp, -tn, -sn, -e, -dir.
Subcommand aliases match the real CLI: g (get), sr (start), hn (handover), c (confirm).
"""

from __future__ import annotations

import argparse
import json
import os
import random
import string
import subprocess
import sys
import time
import urllib.error
import urllib.request
import uuid
from datetime import datetime, timedelta, timezone

STATE_FILE = "/tmp/tcld-migration-state.json"
CONFIG_JSON_PATH = "/Users/luke/git/temporalio/temporal-cloud-high-availability-demos/migration-demo/config.json"
CLOUD_OPS_BASE = "https://saas-api.tmprl.cloud"
LOCAL_TEMPORAL_ADDRESS = "localhost:7233"

RESET = "\033[0m"
DIM = "\033[2m"
BOLD = "\033[1m"
RED = "\033[31m"
GREEN = "\033[32m"
YELLOW = "\033[33m"
BLUE = "\033[34m"
MAGENTA = "\033[35m"
CYAN = "\033[36m"
GRAY = "\033[90m"


def c(color: str, s: str) -> str:
    if not sys.stdout.isatty():
        return s
    return f"{color}{s}{RESET}"


def now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.") + \
           f"{datetime.now(timezone.utc).microsecond // 1000:03d}Z"


def ulid() -> str:
    alphabet = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"
    return "".join(random.choices(alphabet, k=26))


def short_hex(n: int) -> str:
    return "".join(random.choices("0123456789abcdef", k=n))


def ns_uuid() -> str:
    return str(uuid.uuid4())


def log(level: str, component: str, msg: str, **fields) -> None:
    lvl_color = {
        "INFO": CYAN,
        "DEBUG": GRAY,
        "WARN": YELLOW,
        "ERROR": RED,
    }.get(level, CYAN)
    ts = c(GRAY, now_iso())
    lvl = c(lvl_color, f"{level:<5}")
    comp = c(MAGENTA, component)
    extra = ""
    if fields:
        parts = []
        for k, v in fields.items():
            parts.append(f"{c(DIM, k)}={c(BOLD, str(v))}")
        extra = " " + " ".join(parts)
    print(f"{ts} {lvl} {comp}: {msg}{extra}")
    sys.stdout.flush()


def sleep(ms_min: int, ms_max: int | None = None) -> None:
    if ms_max is None:
        ms_max = ms_min
    time.sleep(random.uniform(ms_min, ms_max) / 1000.0)


def load_state() -> dict:
    if not os.path.exists(STATE_FILE):
        return {"migrations": {}, "last_id": None}
    try:
        with open(STATE_FILE) as f:
            return json.load(f)
    except json.JSONDecodeError:
        return {"migrations": {}, "last_id": None}


def save_state(state: dict) -> None:
    with open(STATE_FILE, "w") as f:
        json.dump(state, f, indent=2)


def resolve_id(args_id: str | None, state: dict) -> str:
    if args_id:
        return args_id
    if state.get("last_id"):
        return state["last_id"]
    err("no --id provided and no active migration found in local cache")
    sys.exit(2)


def err(msg: str) -> None:
    print(c(RED, f"Error: {msg}"), file=sys.stderr)


