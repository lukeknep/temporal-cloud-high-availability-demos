def cmd_confirm(args: argparse.Namespace) -> int:
    state = load_state()
    mig_id = resolve_id(args.id, state)
    mig = state["migrations"].get(mig_id)
    if not mig:
        err(f"migration {mig_id} not found")
        return 2

    active = next((r["id"] for r in mig["replicas"] if r["status"] == "Active"), None)
    if active is None:
        err("no active replica; cannot confirm")
        return 2

    print(c(YELLOW + BOLD,
            "WARNING: confirming a migration is IRREVERSIBLE."))
    print(c(YELLOW,
            f"The passive replica will be abandoned and all cross-cluster "
            f"replication state will be torn down."))
    print(c(DIM, "Proceeding (demo mode: --force implied)..."))
    print()
    sleep(400, 600)

    log("INFO", "tcld/migration",
        f"confirming migration {mig_id}",
        active_replica=active)
    sleep(220, 320)

    log("INFO", "tcld/migration",
        "entering CONFIRM_IN_PROGRESS state")
    mig["status"] = "STATE_MIGRATION_CONFIRM_IN_PROGRESS"
    mig["status_code"] = 10
    sleep(140, 220)

    passive = "cloud" if active == "on-prem" else "on-prem"

    log("INFO", "tcld/replication",
        f"tearing down replication stream {active} <-> {passive}")
    sleep(520, 780)
    log("INFO", "tcld/replication",
        "replication stream closed",
        shards_closed=mig["shard_count"],
        leftover_tasks=0)
    sleep(120, 180)

    log("INFO", "tcld/frontend",
        f"marking namespace as non-global (single cluster = {active})",
        namespace=mig["target_namespace"] if active == "cloud" else mig["source_namespace"])
    sleep(340, 520)
    log("INFO", "tcld/frontend",
        "UpdateNamespace.replication_config committed",
        clusters=f"[{active}]",
        is_global_namespace="false")
    sleep(100, 160)

    log("INFO", "tcld/migration",
        f"abandoning {passive} replica")
    sleep(220, 340)
    log("INFO", "tcld/migration",
        "passive replica marked Abandoned",
        replica_id=passive,
        freed_shards=mig["shard_count"],
        reclaimed_storage_gib=random.randint(180, 940))
    sleep(120, 180)

    # Real side effect: when the abandoned replica is the cloud side, issue an
    # actual Cloud Ops API call to delete the namespace.
    if passive == "cloud":
        cloud_ns = mig["target_namespace"]
        api_key = load_cloud_ops_key()
        if api_key:
            log("INFO", "tcld/cloudops",
                f"GET /cloud/namespaces/{cloud_ns} (fetch resource_version)",
                base_url=CLOUD_OPS_BASE)
            ns_obj = cloud_ops_get_namespace(api_key, cloud_ns)
            if ns_obj:
                rv = (
                    (ns_obj.get("namespace") or {}).get("resource_version")
                    or ns_obj.get("resource_version")
                )
                if rv:
                    log("INFO", "tcld/cloudops",
                        "fetched namespace record",
                        resource_version=rv,
                        state=(ns_obj.get("namespace") or {}).get("state", "?"))
                    sleep(120, 220)
                    log("INFO", "tcld/cloudops",
                        f"DELETE /cloud/namespaces/{cloud_ns}",
                        resource_version=rv)
                    resp = cloud_ops_delete_namespace(api_key, cloud_ns, rv)
                    if resp:
                        async_op = resp.get("async_operation") or {}
                        log("INFO", "tcld/cloudops",
                            "namespace deletion accepted",
                            async_operation_id=async_op.get("id", "?"),
                            state=async_op.get("state", "?"))
                else:
                    log("WARN", "tcld/cloudops",
                        "no resource_version in GET response; skipping DELETE")
        sleep(120, 180)

    log("INFO", "tcld/s2sproxy",
        "tearing down S2S Proxy channel",
        endpoint_id=mig["migration_endpoint_id"])
    sleep(280, 420)
    log("INFO", "tcld/s2sproxy",
        "channel closed",
        bytes_in=f"{random.randint(240, 980)}GiB",
        bytes_out=f"{random.randint(12, 74)}GiB",
        uptime=f"{random.randint(3, 19)}h{random.randint(0,59)}m")
    sleep(100, 160)

    log("INFO", "tcld/migration",
        "emitting migration.confirmed audit event",
        audit_id=ns_uuid())
    sleep(140, 220)

    # Finalize state.
    for r in mig["replicas"]:
        r["status"] = "Active" if r["id"] == active else "Abandoned"
    mig["status"] = "STATE_MIGRATION_CONFIRMED"
    mig["status_code"] = 6
    mig["last_modified_at"] = now_iso()
    mig["version"] += 1
    mig["confirmed_at"] = mig["last_modified_at"]
    state["migrations"][mig_id] = mig
    save_state(state)

    print()
    print(c(GREEN + BOLD, "Migration confirmed."))
    print(c(DIM, f"Active replica: {active}. Namespace is now single-cluster."))
    print()
    print_migration(mig)
    return 0


