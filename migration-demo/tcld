def cmd_handover(args: argparse.Namespace) -> int:
    state = load_state()
    mig_id = resolve_id(args.id, state)
    mig = state["migrations"].get(mig_id)
    if not mig:
        err(f"migration {mig_id} not found")
        return 2

    if args.to_replica_id not in ("cloud", "on-prem"):
        err(f"invalid --to-replica-id {args.to_replica_id!r}; must be 'cloud' or 'on-prem'")
        return 2

    to_replica = args.to_replica_id
    from_replica = "cloud" if to_replica == "on-prem" else "on-prem"

    log("INFO", "tcld/migration",
        f"initiating handover of {mig_id} to replica {c(BOLD, to_replica)}")
    sleep(160, 240)
    log("INFO", "tcld/migration",
        "validating pre-handover invariants")
    sleep(220, 360)
    log("INFO", "tcld/migration",
        "pre-handover checks passed",
        replication_lag_ms=random.randint(6, 22),
        shard_parity=f"{mig['shard_count']}/{mig['shard_count']}",
        pending_replication_tasks=random.randint(0, 40))
    sleep(110, 180)

    log("INFO", "tcld/matching",
        f"draining task queues on {from_replica}",
        task_queues=random.randint(140, 520))
    sleep(420, 640)
    log("INFO", "tcld/matching",
        "task queues quiesced",
        drained_tasks=random.randint(4_800, 21_000),
        residual=0)
    sleep(110, 180)

    log("INFO", "tcld/frontend",
        f"entering read-only window on {from_replica}",
        duration_budget_ms=8000)
    sleep(240, 360)

    log("INFO", "tcld/history",
        f"flushing in-flight history events on {from_replica}",
        shards=mig["shard_count"])
    sleep(560, 820)
    log("INFO", "tcld/history",
        "history flushed; last_event_ids propagated",
        high_watermark_ms=random.randint(3, 14))
    sleep(120, 180)

    log("INFO", "tcld/replication",
        "awaiting final replication ack from target cluster")
    sleep(420, 640)
    log("INFO", "tcld/replication",
        "final ack received",
        tail_events_replicated=random.randint(180, 920))
    sleep(100, 160)

    log("INFO", "tcld/migration",
        f"promoting {to_replica} to ACTIVE and demoting {from_replica} to PASSIVE")
    sleep(320, 480)
    log("INFO", "tcld/frontend",
        "UpdateNamespace.active_cluster_name committed",
        namespace=mig["target_namespace"] if to_replica == "cloud" else mig["source_namespace"],
        active_cluster=to_replica,
        failover_version=mig["failover_versions"][to_replica])
    sleep(180, 260)

    log("INFO", "tcld/matching",
        f"unblocking task queues on {to_replica}")
    sleep(220, 340)

    # Mutate state.
    for r in mig["replicas"]:
        r["status"] = "Active" if r["id"] == to_replica else "PassiveInSync"
    mig["status"] = "STATE_MIGRATION_HANDOVER_COMPLETE"
    mig["status_code"] = 4 if to_replica == "cloud" else 3  # C2S keeps room for re-confirm
    mig["last_modified_at"] = now_iso()
    mig["version"] += 1
    mig["last_handover"] = {
        "to_replica_id": to_replica,
        "from_replica_id": from_replica,
        "completed_at": mig["last_modified_at"],
        "total_elapsed_ms": random.randint(2800, 4400),
    }
    state["migrations"][mig_id] = mig
    save_state(state)

    print()
    print(c(GREEN + BOLD, f"Handover to '{to_replica}' complete."))
    print()
    print_migration(mig)
    print()
    if to_replica == "on-prem":
        print(c(YELLOW, "Traffic is now served from the on-prem cluster."))
        print(c(DIM, "The cloud replica remains in sync as a fallback. "
                    "Run 'tcld migration confirm' once you're ready to tear it down,"))
        print(c(DIM, "or 'tcld migration handover --to-replica-id cloud' to fail back."))
    else:
        print(c(YELLOW, "Traffic is now served from Temporal Cloud."))
        print(c(DIM, "Run 'tcld migration confirm' to finalize (irreversible)."))
    return 0


