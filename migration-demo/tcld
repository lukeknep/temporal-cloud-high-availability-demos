# real-world side effects: local namespace create + Cloud Ops delete
# ---------------------------------------------------------------------------

def create_local_namespace(ns: str, retention: str = "7d") -> None:
    """Shell out to 'temporal operator namespace create' against the local cluster."""
    log("INFO", "tcld/local",
        f"registering namespace {c(BOLD, ns)} on local cluster",
        address=LOCAL_TEMPORAL_ADDRESS)
    cmd = [
        "temporal", "operator", "namespace", "create",
        "--address", LOCAL_TEMPORAL_ADDRESS,
        "--retention", retention,
        ns,
    ]
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=10)
    except FileNotFoundError:
        log("WARN", "tcld/local", "'temporal' CLI not on PATH; skipping local register")
        return
    except subprocess.TimeoutExpired:
        log("WARN", "tcld/local",
            "local cluster unreachable (timeout); skipping local register",
            address=LOCAL_TEMPORAL_ADDRESS)
        return

    stderr = (result.stderr or "").strip()
    if result.returncode == 0:
        log("INFO", "tcld/local", "local namespace registered",
            namespace=ns, retention=retention)
    elif "already exists" in stderr.lower() or "AlreadyExists" in stderr:
        log("INFO", "tcld/local", "local namespace already present; continuing",
            namespace=ns)
    else:
        last_line = stderr.splitlines()[-1] if stderr else "(no stderr)"
        log("WARN", "tcld/local", "namespace create returned non-zero",
            exit_code=result.returncode, stderr=last_line[:160])


def load_cloud_ops_key() -> str | None:
    try:
        with open(CONFIG_JSON_PATH) as f:
            cfg = json.load(f)
    except (OSError, json.JSONDecodeError) as e:
        log("WARN", "tcld/cloudops",
            f"could not load config.json", path=CONFIG_JSON_PATH, error=str(e))
        return None
    key = (cfg.get("temporal") or {}).get("cloudOpsAPIKey")
    if not key:
        log("WARN", "tcld/cloudops",
            "cloudOpsAPIKey not found in config.json")
    return key


def _cloud_ops_request(method: str, path: str, api_key: str,
                       body: dict | None = None) -> tuple[int, dict | None, str]:
    url = f"{CLOUD_OPS_BASE}{path}"
    data = json.dumps(body).encode("utf-8") if body is not None else None
    headers = {
        "Authorization": f"Bearer {api_key}",
        "Accept": "application/json",
    }
    if data is not None:
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            raw = resp.read().decode("utf-8", errors="replace")
            parsed = json.loads(raw) if raw else None
            return resp.status, parsed, raw
    except urllib.error.HTTPError as e:
        raw = e.read().decode("utf-8", errors="replace") if hasattr(e, "read") else ""
        try:
            parsed = json.loads(raw) if raw else None
        except json.JSONDecodeError:
            parsed = None
        return e.code, parsed, raw
    except urllib.error.URLError as e:
        return 0, None, f"URLError: {e.reason}"
    except Exception as e:  # noqa: BLE001
        return 0, None, f"{type(e).__name__}: {e}"


def cloud_ops_get_namespace(api_key: str, namespace: str) -> dict | None:
    status, body, raw = _cloud_ops_request("GET",
        f"/cloud/namespaces/{namespace}", api_key)
    if status == 200 and isinstance(body, dict):
        return body
    log("WARN", "tcld/cloudops",
        f"GET /cloud/namespaces/{namespace} failed",
        status=status, body=(raw or "")[:200])
    return None


def cloud_ops_delete_namespace(api_key: str, namespace: str,
                               resource_version: str) -> dict | None:
    payload = {
        "resource_version": resource_version,
        "async_operation_id": f"tcld-confirm-{short_hex(10)}",
    }
    status, body, raw = _cloud_ops_request("DELETE",
        f"/cloud/namespaces/{namespace}", api_key, body=payload)
    if status in (200, 202) and isinstance(body, dict):
        return body
    log("WARN", "tcld/cloudops",
        f"DELETE /cloud/namespaces/{namespace} failed",
        status=status, body=(raw or "")[:200])
    return None


