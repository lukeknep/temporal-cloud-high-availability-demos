def print_migration(mig: dict) -> None:
    def row(label: str, value: str, color: str = BOLD) -> None:
        print(f"  {c(DIM, label.ljust(24))}{c(color, value)}")

    status_color = {
        "STATE_MIGRATION_MIGRATION_STARTED": CYAN,
        "STATE_MIGRATION_HANDOVER_PENDING": YELLOW,
        "STATE_MIGRATION_HANDOVER_COMPLETE": YELLOW,
        "STATE_MIGRATION_CONFIRM_IN_PROGRESS": YELLOW,
        "STATE_MIGRATION_CONFIRMED": GREEN,
        "STATE_MIGRATION_FAILED": RED,
        "STATE_MIGRATION_CANCELLED": RED,
    }.get(mig["status"], BOLD)

    print(c(BOLD, "Migration:"))
    row("ID:", mig["id"])
    row("Account ID:", mig["account_id"])
    row("Direction:", mig["direction"])
    row("Status:", f"{mig['status']} ({mig['status_code']})", status_color)
    row("Migration Endpoint ID:", mig["migration_endpoint_id"])
    row("Source Namespace:", f"{mig['source_namespace']} ({mig['source_namespace_id']})")
    row("Target Namespace:", f"{mig['target_namespace']} ({mig['target_namespace_id']})")
    row("Cell:", f"{mig['cell_id']} ({mig['region']})")
    row("History Shards:", str(mig["shard_count"]))
    row("Failover Versions:",
        f"on-prem={mig['failover_versions']['on-prem']}, cloud={mig['failover_versions']['cloud']}")
    row("Created At:", mig["created_at"])
    row("Last Modified At:", mig["last_modified_at"])
    row("Last Modified By:", mig["last_modified_by"])
    row("Version:", str(mig["version"]))
    print(f"  {c(DIM, 'Replicas:')}")
    for r in mig["replicas"]:
        color = {
            "Active": GREEN,
            "PassiveInSync": CYAN,
            "PassiveOutOfSync": YELLOW,
            "Abandoned": GRAY,
            "Unknown": RED,
        }.get(r["status"], BOLD)
        print(f"    - {c(BOLD, r['id'].ljust(8))}  status: {c(color, r['status'])}")


# ---------------------------------------------------------------------------
# argparse plumbing
# ---------------------------------------------------------------------------

def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="tcld",
        description="Temporal Cloud CLI (mock, migration subcommands only)",
    )
    sub = parser.add_subparsers(dest="topic", required=True)

    migration = sub.add_parser("migration", help="manage customer-driven migrations")
    msub = migration.add_subparsers(dest="action", required=True)

    # start / sr
    p_start = msub.add_parser("start", aliases=["sr"], help="start a migration")
    p_start.add_argument("--migration-endpoint-id", "--endpoint-id", "-e",
                         dest="endpoint_id", required=True,
                         help="the migration endpoint id")
    p_start.add_argument("--source-namespace", "-sn", dest="source_namespace", required=True,
                         help="the source namespace name")
    p_start.add_argument("--target-namespace", "-tn", dest="target_namespace", required=True,
                         help="the target namespace name")
    p_start.add_argument("--direction", "-dir", dest="direction",
                         choices=["s2c", "c2s"], default="s2c",
                         help="migration direction: 's2c' (self-hosted to cloud) or 'c2s'")
    p_start.set_defaults(func=cmd_start)

    # get / g
    p_get = msub.add_parser("get", aliases=["g"], help="get a migration")
    p_get.add_argument("--id", "-id", dest="id", default=None,
                       help="the migration id (defaults to last started)")
    p_get.set_defaults(func=cmd_get)

    # handover / hn
    p_ho = msub.add_parser("handover", aliases=["hn"], help="handover the active replica")
    p_ho.add_argument("--id", "-id", dest="id", default=None,
                      help="the migration id (defaults to last started)")
    p_ho.add_argument("--to-replica-id", "-rp", dest="to_replica_id", required=True,
                      choices=["cloud", "on-prem"],
                      help="the target replica id for handover")
    p_ho.set_defaults(func=cmd_handover)

    # confirm / c
    p_cf = msub.add_parser("confirm", aliases=["c"], help="confirm migration (irreversible)")
    p_cf.add_argument("--id", "-id", dest="id", default=None,
                      help="the migration id (defaults to last started)")
    p_cf.set_defaults(func=cmd_confirm)

    return parser


def main(argv: list[str]) -> int:
    # Demo-friendly defaults: if the user runs the bare subcommand with no
    # flags (as in the brief), fill in plausible values rather than erroring.
    if len(argv) >= 3 and argv[1] == "migration":
        action = argv[2]
        rest = argv[3:]
        if action in ("start", "sr") and not rest:
            argv = argv + [
                "--endpoint-id", f"mep-{short_hex(12)}",
                "--source-namespace", "orders.prod",
                "--target-namespace", "orders.acct-5f7c2a9e",
            ]

    parser = build_parser()
    args = parser.parse_args(argv[1:])
    return args.func(args)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except KeyboardInterrupt:
        print()
        print(c(RED, "interrupted"), file=sys.stderr)
        sys.exit(130)
